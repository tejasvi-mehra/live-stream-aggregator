# Required — app fails fast at startup if unset
VITE_API_BASE=http://localhost:3002

# Stream catalog YAML (fetched at runtime; edit on GitHub without redeploying the app)
VITE_CATALOG_URL=https://raw.githubusercontent.com/tejasvi-mehra/live-stream-aggregator/main/config/streams.yaml

# Set to false to disable all YouTube sources at build time
# VITE_YOUTUBE_ENABLED=false

# Override YAML activeProfile without editing streams.yaml
# VITE_STREAM_PROFILE=production
